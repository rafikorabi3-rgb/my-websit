# Public base URL of the deployed site (no trailing slash).
# Used for canonical URLs, sitemap.xml, robots.txt, RSS feeds, and JSON-LD.
# On Cloudflare Workers this is also set in wrangler.jsonc (vars.NEXT_PUBLIC_SITE_URL)
# or as a dashboard environment variable — see README "Deploy — Cloudflare Workers".
NEXT_PUBLIC_SITE_URL=https://example.com

# Only needed if you want an assistant to run `npm run deploy` on your
# behalf instead of using Cloudflare's Git integration. Scope it to just
# "Edit Cloudflare Workers" — never commit a real token here.
# CLOUDFLARE_API_TOKEN=
